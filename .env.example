# ============================================================
# FunASR 流式语音识别服务 — 环境配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# ─── 云服务器配置 ───
SERVER_IP=8.153.92.96
SERVER_USER=root
SERVER_PASS=myegoo@3466

# ─── Docker 容器 ───
CONTAINER_NAME=funasr-stream
SERVICE_PORT=5002

# ─── 宿主机路径映射 ───
# 宿主机上的模型/结果/音频目录（通过 docker -v 挂载到容器内）
HOST_MODEL_DIR=/opt/funasr/models
HOST_RESULT_DIR=/opt/funasr/results
HOST_AUDIO_DIR=/opt/funasr/audio

# ─── 容器内路径（一般不需修改） ───
CONTAINER_WORKDIR=/opt/funasr
CONTAINER_SERVER_PATH=/opt/funasr/stream_server.py
