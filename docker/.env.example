# ============================================================
#  FunASR 流式语音识别 — 客户配置参数
#  部署前请根据实际环境修改以下参数
# ============================================================

# ─── 并发与性能 ─────────────────────────────────────────────
# 推理线程数（决定并发上限）
# 规则：decoder ≈ 目标并发数 / 2.5（向上取整到偶数）
# io ≈ decoder / 2
# 示例：5并发 → decoder=2, io=2
#       10并发 → decoder=4, io=2
#       20并发 → decoder=8, io=4
#       40并发 → decoder=16, io=8
DECODER_THREAD_NUM=2
IO_THREAD_NUM=2

# 最大并发会话数（建议 = 目标并发数 × 1.25，留余量）
MAX_SESSIONS=20

# 会话超时（秒，无音频后自动清理）
# 浏览器麦克风场景：15
# 呼叫中心场景：30
SESSION_TIMEOUT=15

# ─── 资源限制 ───────────────────────────────────────────────
# 容器 CPU 上限（按服务器实际核数设置）
CONTAINER_CPUS=4.0

# 容器内存上限（建议 Runtime 1GB + 系统 2GB）
CONTAINER_MEMORY=6G

# ─── 路径配置 ───────────────────────────────────────────────
# 模型文件目录（客户服务器上模型的实际存放路径）
MODEL_DIR=/opt/argosasr/models/iic

# 识别结果存储路径
RESULT_DIR=/opt/streaming-asr/results

# 录音文件存储路径
AUDIO_DIR=/opt/streaming-asr/audio

# ─── 端口 ───────────────────────────────────────────────────
# 对外服务端口（客户端 WebSocket 连接端口）
SERVICE_PORT=5002

# Runtime 内部端口（一般无需修改）
RUNTIME_PORT=10095

# ─── License 授权服务 ─────────────────────────────────────
# License 服务器地址
# 同一台服务器: host-gateway（默认值，容器访问宿主机）
# 不同服务器:   填写 License 服务器的实际 IP，如 192.168.1.100
LICENSE_SERVER_IP=host-gateway

# License 服务端口（默认 9800）
LICENSE_SERVER_PORT=9800
