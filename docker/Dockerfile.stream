# FunASR 流式语音识别服务 (sherpa-onnx)
# 精简镜像：仅包含流式识别所需
FROM python:3.9-slim

WORKDIR /opt/funasr

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
RUN pip install --no-cache-dir \
    flask \
    flask-socketio \
    numpy \
    sherpa-onnx==1.13.7 \
    -i https://mirrors.aliyun.com/pypi/simple/

# 复制流式服务代码
COPY stream_server.py /opt/funasr/stream_server.py

# 复制 sherpa-onnx 模型 (INT8 量化)
COPY sherpa-model/ /opt/funasr/model/

# 创建结果目录
RUN mkdir -p /opt/funasr/results /opt/funasr/audio

EXPOSE 5002

CMD ["python3", "/opt/funasr/stream_server.py"]
