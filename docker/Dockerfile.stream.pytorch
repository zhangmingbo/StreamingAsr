FROM funasr-onnx-v3
WORKDIR /opt/funasr

# 安装 Flask-SocketIO（funasr 1.4.1 已安装）
RUN pip install --no-cache-dir flask-socketio -i https://mirrors.aliyun.com/pypi/simple/

# 复制流式服务代码（PyTorch Paraformer-large 版本）
COPY stream_server_pytorch.py /opt/funasr/stream_server.py

# 复制测试页面
COPY stream_test.html /opt/funasr/stream_test.html

# 创建结果目录
RUN mkdir -p /opt/funasr/results /opt/funasr/audio

EXPOSE 5002

CMD ["python3", "/opt/funasr/stream_server.py"]
